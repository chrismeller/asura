package views

import (
	"fmt"
	"time"
)

// HeartbeatView is the ping URL panel of a heartbeat monitor's page.
type HeartbeatView struct {
	// ServerURL is the external base URL the ping URL is built on.
	ServerURL string
	// Exists is false for a heartbeat monitor without a token yet (made a
	// heartbeat by an edit, or imported).
	Exists     bool
	Status     string
	Grace      int
	LastPingAt *time.Time
	// NewToken is set only on the response right after the token was
	// created; the store keeps just its hash, so it is shown this once.
	NewToken string
}

// PingURL is the URL a job calls to report in. Like the agent run command, it
// is built here from the configured external URL and the token.
func (v HeartbeatView) PingURL() string {
	return v.ServerURL + "/api/v1/heartbeat/" + v.NewToken
}

func (v HeartbeatView) schedule(interval int) string {
	if v.Grace > 0 {
		return fmt.Sprintf("Expects a ping every %ds, plus %ds grace.", interval, v.Grace)
	}
	return fmt.Sprintf("Expects a ping every %ds.", interval)
}

func (v HeartbeatView) curlCommand() string {
	return fmt.Sprintf("curl -fsS -m 10 --retry 3 %s", v.PingURL())
}

templ heartbeatPanel(p MonitorDetailParams) {
	// The page refreshes itself by re-requesting its URL, which no longer
	// carries the token once the reveal is used: hx-preserve keeps the shown
	// URL on screen until the user navigates away.
	<div id="heartbeat-reveal" hx-preserve="true">
		if p.Heartbeat.NewToken != "" {
			<div class="card card-pad mb-6 border-brand" role="status" x-data={ fmt.Sprintf("{ copied: '', url: '%s', cmd: '%s' }", JSEscapeString(p.Heartbeat.PingURL()), JSEscapeString(p.Heartbeat.curlCommand())) }>
				<h2 class="text-md font-semibold">Ping URL</h2>
				<p class="subtitle mt-1 mb-3">Copy the URL now. It is not shown again; if you lose it, regenerate it.</p>
				<div class="flex flex-col sm:flex-row gap-2">
					<code data-testid="heartbeat-url" class="flex-1 min-w-0 px-3 py-2 rounded-control border border-line-light bg-surface text-xs font-mono text-white break-all">{ p.Heartbeat.PingURL() }</code>
					<button type="button" class="btn-secondary shrink-0" @click="navigator.clipboard.writeText(url).then(() => copied = 'url')">
						<span x-text="copied === 'url' ? 'Copied' : 'Copy URL'">Copy URL</span>
					</button>
				</div>
				<p class="form-hint mt-3 mb-1">Call it with GET or POST whenever the job succeeds, for example at the end of a cron job:</p>
				<div class="flex flex-col sm:flex-row gap-2">
					<code class="flex-1 min-w-0 px-3 py-2 rounded-control border border-line-light bg-surface text-xs font-mono text-muted-light break-all">{ p.Heartbeat.curlCommand() }</code>
					<button type="button" class="btn-secondary shrink-0" @click="navigator.clipboard.writeText(cmd).then(() => copied = 'cmd')">
						<span x-text="copied === 'cmd' ? 'Copied' : 'Copy command'">Copy command</span>
					</button>
				</div>
			</div>
		}
	</div>
	<section id="heartbeat-panel" class="card card-pad mb-6" aria-labelledby="heartbeat-title">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 id="heartbeat-title" class="text-md font-semibold">Heartbeat</h2>
				if p.Heartbeat.Exists {
					<p class="subtitle mt-1">{ p.Heartbeat.schedule(p.Monitor.Interval) }</p>
					<p class="subtitle mt-1">
						Last ping:
						if p.Heartbeat.LastPingAt != nil {
							@RelTime(*p.Heartbeat.LastPingAt)
						} else {
							<span>never</span>
						}
					</p>
					<p class="form-hint mt-1">The ping URL contains a secret token and is only shown when it is created.</p>
				} else {
					<p class="subtitle mt-1">This monitor has no ping URL yet, so it cannot receive pings.</p>
				}
			</div>
			if p.Can("monitors.write") {
				if p.Heartbeat.Exists {
					<button
						type="button"
						data-url={ fmt.Sprintf("%s/monitors/%d/heartbeat/regenerate", p.BasePath, p.Monitor.ID) }
						data-msg="Generate a new ping URL? The current URL stops working immediately, so update every job that uses it."
						@click="$dispatch('confirm',{url:$el.dataset.url,message:$el.dataset.msg})"
						class="btn-secondary shrink-0"
					>Regenerate URL</button>
				} else {
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("%s/monitors/%d/heartbeat/regenerate", p.BasePath, p.Monitor.ID)) }>
						<button type="submit" class="btn-primary shrink-0">Generate URL</button>
					</form>
				}
			}
		</div>
	</section>
}
